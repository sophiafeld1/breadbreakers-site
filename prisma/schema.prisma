generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MASTER
  USER
}

enum EventFormVariant {
  standard
  extended
}

model User {
  id                String   @id @default(cuid())
  username          String   @unique
  passwordHash      String
  passwordEncrypted String?
  role              UserRole @default(USER)
  createdAt         DateTime @default(now())
}

model Event {
  id                String           @id @default(cuid())
  slug              String           @unique
  chapter           String           @default("Reston")
  title             String
  month             String
  day               String
  dateLabel         String
  timeLabel         String
  venueName         String?
  mapQuery          String?
  googleCalendarUrl String?
  image             String           @default("/DSC00573.jpg")
  imageAlt          String           @default("BreadBreakers Community Dinner")
  isUpcoming        Boolean          @default(true)
  formName          String
  formVariant       EventFormVariant @default(standard)
  description       Json?
  calendarStart     String?
  calendarEnd       String?
  rsvps             Rsvp[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Rsvp {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String
  guestCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([eventId])
}
